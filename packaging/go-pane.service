[Unit]
Description=OpenCode Go usage poller for the go-pane plasmoid
Documentation=https://github.com/4ster-light/go-pane
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/bin/go-pane serve
Restart=on-failure
RestartSec=5
# Optional: uncomment to log more.
# Environment=GO_PANE_LOG_LEVEL=debug

[Install]
WantedBy=default.target
